{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pmndrs.github.io/examples/schemas/pmndrs.schema.json",
  "title": "pmndrs example metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "title",
    "description",
    "tags",
    "authors",
    "source",
    "libraries",
    "assets"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/pmndrs.schema.json"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "ambient-occlusion",
          "animation",
          "annotations",
          "aspect-ratio",
          "audio",
          "backdrop",
          "baking",
          "barycentric",
          "batching",
          "bezier",
          "bloom",
          "blur",
          "bones",
          "bounds",
          "bvh",
          "camera-shake",
          "cell-fracture",
          "chromatic-aberration",
          "clone",
          "collisions",
          "compression",
          "configurator",
          "contact-shadows",
          "controls",
          "convex-polyhedron",
          "csg",
          "custom-renderer",
          "debug",
          "decal",
          "depth",
          "distortion",
          "dof",
          "dot-screen",
          "environment",
          "events",
          "expand",
          "film",
          "fisheye",
          "flexbox",
          "game",
          "geometry",
          "gltf",
          "gobo",
          "god-rays",
          "gpgpu",
          "gradient",
          "grid",
          "ground-projection",
          "hdr",
          "highlight",
          "hmr",
          "horizontal",
          "html",
          "hud",
          "infinite",
          "instances",
          "interaction",
          "intersection",
          "lerp",
          "lightformer",
          "lighting",
          "lightmap",
          "loading",
          "lod",
          "lut",
          "mask",
          "material",
          "merging",
          "noise",
          "occlusion",
          "outlines",
          "parallax",
          "particles",
          "pcss",
          "physics",
          "pixelation",
          "portal",
          "postprocessing",
          "progressive",
          "raycast",
          "re-use",
          "rectarea-lights",
          "reflections",
          "refraction",
          "router",
          "scanline",
          "scroll",
          "selection",
          "selective",
          "sepia",
          "shader",
          "shadows",
          "snap",
          "soft-particles",
          "soft-shadows",
          "spotlight",
          "spring",
          "ssgi",
          "ssr",
          "stage",
          "state",
          "stencil",
          "suspense",
          "svg",
          "text",
          "text-geometry",
          "texture",
          "trail",
          "transitions",
          "transmission",
          "vertex-colors",
          "vertical",
          "video-texture",
          "views",
          "vignette",
          "volumetric",
          "wireframe"
        ]
      },
      "uniqueItems": true
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "publishedAt": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "libraries": {
      "type": "array",
      "items": {
        "enum": [
          "@react-spring/core",
          "@react-spring/three",
          "@react-spring/web",
          "@react-three/cannon",
          "@react-three/csg",
          "@react-three/drei",
          "@react-three/fiber",
          "@react-three/flex",
          "@react-three/postprocessing",
          "@react-three/rapier",
          "@use-gesture/react",
          "ecctrl",
          "jotai",
          "lamina",
          "leva",
          "maath",
          "meshline",
          "valtio",
          "zustand"
        ]
      },
      "uniqueItems": true
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "creator": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "licenseUrl": {
          "type": "string",
          "format": "uri"
        },
        "modified": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
