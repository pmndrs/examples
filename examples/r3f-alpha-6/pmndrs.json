      "license": "OFL-1.1",
      "modified": true,
      "notes": "Weight 600 baked to a Glyph font with outlines."
    },
    {
      "name": "IBM Plex Mono",
      "files": ["src/assets/IBMPlexMono-Regular.font.glb"],
