{
  "$schema": "../../schemas/pmndrs.schema.json",
  "title": "R3F Alpha 6",
  "description": "The React Three Fiber v10 Alpha 6 announcement, WebGPU first. Glass type on a TSL floor shatters into live shards with refraction, colored caustics and room reflections. Click the shards to pop them.",
  "tags": [
    "webgpu",
    "tsl",
    "transmission",
    "refraction",
    "reflections",
    "shadows",
    "cell-fracture",
    "physics",
    "text",
    "hdr"
  ],
  "authors": ["Dennis Smolek", "Anderson Mancini"],
  "source": "https://github.com/DennisSmolek/r3f-alpha-6",
  "libraries": ["@react-three/fiber", "@pmndrs/glyph", "leva"],
  "assets": [
    {
      "name": "Studio Small 09",
      "files": ["src/assets/studio_small_09_1k.hdr"],
      "creator": "Sergej Majboroda",
