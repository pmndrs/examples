      "license": "CC0-1.0"
    },
    {
      "name": "Manrope",
      "files": ["src/assets/Manrope-SemiBold.font.glb"],
      "source": "https://github.com/google/fonts/tree/main/ofl/manrope",
      "license": "OFL-1.1",
      "modified": true,
      "notes": "Weight 600 baked to a Glyph font with outlines."
    },
    {
      "name": "Space Grotesk",
      "files": ["src/assets/SpaceGrotesk-SemiBold.font.glb"],
